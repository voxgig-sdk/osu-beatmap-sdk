          contract: {
            id: "GET /search"
            json: "{\"operationId\":\"searchBeatmaps\",\"parameters\":[{\"description\":\"Search query string\",\"in\":\"query\",\"name\":\"q\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Game mode filter (0=osu!, 1=Taiko, 2=Catch, 3=Mania)\",\"in\":\"query\",\"name\":\"mode\",\"required\":false,\"schema\":{\"enum\":[0,1,2,3],\"type\":\"integer\"}},{\"description\":\"Beatmap status (ranked, qualified, loved, pending, etc.)\",\"in\":\"query\",\"name\":\"status\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Pagination offset\",\"in\":\"query\",\"name\":\"offset\",\"required\":false,\"schema\":{\"default\":0,\"type\":\"integer\"}},{\"description\":\"Number of results to return\",\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"default\":50,\"maximum\":100,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"beatmaps\":{\"items\":{\"properties\":{\"approved_date\":{\"description\":\"Date when beatmap was approved/ranked\",\"format\":\"date-time\",\"type\":\"string\"},\"ar\":{\"description\":\"Approach rate\",\"format\":\"float\",\"type\":\"number\"},\"artist\":{\"description\":\"Song artist\",\"type\":\"string\"},\"beatmapset_id\":{\"description\":\"Beatmap set ID\",\"type\":\"integer\"},\"bpm\":{\"description\":\"Beats per minute\",\"format\":\"float\",\"type\":\"number\"},\"creator\":{\"description\":\"Beatmap creator username\",\"type\":\"string\"},\"cs\":{\"description\":\"Circle size\",\"format\":\"float\",\"type\":\"number\"},\"difficulty_rating\":{\"description\":\"Star rating\",\"format\":\"float\",\"type\":\"number\"},\"favourite_count\":{\"description\":\"Number of favorites\",\"type\":\"integer\"},\"hp\":{\"description\":\"HP drain\",\"format\":\"float\",\"type\":\"number\"},\"id\":{\"description\":\"Beatmap ID\",\"type\":\"integer\"},\"last_updated\":{\"description\":\"Last update date\",\"format\":\"date-time\",\"type\":\"string\"},\"length\":{\"description\":\"Song length in seconds\",\"type\":\"integer\"},\"max_combo\":{\"description\":\"Maximum combo\",\"type\":\"integer\"},\"mode\":{\"description\":\"Game mode (0=osu!, 1=Taiko, 2=Catch, 3=Mania)\",\"type\":\"integer\"},\"od\":{\"description\":\"Overall difficulty\",\"format\":\"float\",\"type\":\"number\"},\"playcount\":{\"description\":\"Total play count\",\"type\":\"integer\"},\"status\":{\"description\":\"Beatmap status (ranked, qualified, loved, etc.)\",\"type\":\"string\"},\"title\":{\"description\":\"Song title\",\"type\":\"string\"},\"version\":{\"description\":\"Difficulty name\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"total\":{\"description\":\"Total number of results\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Successful search response\"},\"400\":{\"description\":\"Bad request - invalid parameters\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
